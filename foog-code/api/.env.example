# --- FOOG API ---
NODE_ENV=development
PORT=4000
# Bitta domen ostida ishlaganda web manzili (CORS va cookie uchun)
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foog?schema=public
REDIS_URL=redis://localhost:6379
# Kamida 32 belgi. Web (.env) dagi JWT_SECRET bilan bir xil bo‘lishi shart
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars
# Fayllar shu papkaga saqlanadi va /uploads orqali beriladi
UPLOAD_DIR=./uploads
# Telegram bot (@BotFather dan olinadi)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=foog_uz_bot
# polling – lokal ishlab chiqish; webhook – server (TELEGRAM_WEBHOOK_URL kerak)
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=change-me
# Faqat lokal sinov uchun: botsiz "raqam ulashish"ni taqlid qilish. Serverda false!
AUTH_DEV_LOGIN=true
# Bron javobsiz qolsa necha daqiqada avtomatik bekor bo‘ladi
BOOKING_TTL_MINUTES=120
