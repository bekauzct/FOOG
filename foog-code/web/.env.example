# API server manzili (Next.js /api/v1 va /uploads ni shu yerga yo‘naltiradi)
API_URL=http://localhost:4000
# Brauzer WebSocket manzili. Bo‘sh bo‘lsa: lokal – ws://localhost:4000/ws, serverda – wss://<domen>/ws
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
# API dagi JWT_SECRET bilan bir xil (middleware rolni tekshiradi)
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars
# Lokal sinov: Telegram botsiz «raqam ulashish» tugmasi (serverda false)
NEXT_PUBLIC_DEV_LOGIN=true
NEXT_PUBLIC_BOT_USERNAME=foog_uz_bot
